# Server-only Supabase credentials (never commit a filled-in .env)
# Copy to .env and replace with values from:
#   Supabase → Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: comma-separated extra browser origins allowed to call /api
# (localhost Expo web ports are already allowed by default in server.js)
# CORS_ORIGINS=https://app.habitstackerapp.com

# Web Push (installed PWA daily notifications). Generate with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Native iOS push (Capacitor app). Create an APNs Auth Key (.p8) in Apple Developer:
#   Certificates, Identifiers & Profiles → Keys → + → Apple Push Notifications service (APNs)
# APNS_KEY_ID=your_key_id
# APNS_TEAM_ID=9TDJJ3V4DD
# APNS Auth KEY ID = Y647BBCR4M
# APNS_KEY_PATH=/absolute/path/to/AuthKey_XXXXXX.p8
# Or paste the .p8 contents (use \n for newlines):
# APNS_KEY= MIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQgCLP7e+kPtXHDTyGc
M8uSPHHwmZVkxEWal213Sxxiym+gCgYIKoZIzj0DAQehRANCAAQ8KY4oo2RIJEst
PjEQsEkc5ms2d5rfKDGF+cfWL+rQmm+IxBkxDVrGIp13Q+pukEUxmqAQQ3h/SmKp
kaL1LI+K
# APNS_BUNDLE_ID=com.habitstackerapp.app
# APNS_PRODUCTION=true

# Daily cron: POST /api/cron/daily-achievements with Authorization: Bearer <secret>
# CRON_SECRET=
# DAILY_TZ=America/Los_Angeles
